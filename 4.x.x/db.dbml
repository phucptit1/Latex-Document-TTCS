// ============================================================
// Rice Disease Detection System - Database Schema
// Version: 3.4.0 (Academic Standardized)
// Engine: PostgreSQL (Standard SQL compatible)
// ============================================================

Project rice_disease_detection {
  database_type: 'PostgreSQL'
  Note: '''
    Hệ thống nhận diện bệnh trên cây lúa dựa trên thuật toán học sâu CNN.
    - Sử dụng pgvector cho tìm kiếm ngữ nghĩa tri thức dinh dưỡng (RAG).
    - Redis (lưu trữ ngoài CSDL): 
      + login:fail:{username} (15-30p TTL)
      + otp:{email} (10p TTL)
      + verify:{token} (24h TTL)
  '''
}

// ------------------------------------------------------------
// 1. Bảng người dùng (Authentication)
// ------------------------------------------------------------
Table users {
  id UUID [pk]
  username VARCHAR(50) [unique, not null]
  email VARCHAR(255) [unique, not null]
  password VARCHAR [note: 'Nullable for social logins']
  role enum('FARMER', 'ADMIN') [not null, default: 'FARMER']
  status enum('active', 'inactive', 'suspended') [not null, default: 'inactive']
  avatar_url VARCHAR(512) [not null, default: 'https://res.cloudinary.com/ptquanh/image/upload/v1779947161/default-avatar.png']
  metadata JSONB [note: 'Cấu hình hoặc thông tin bổ sung']
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
  
  Indexes {
    username
    email
  }
}

// ------------------------------------------------------------
// 2. Bảng hồ sơ cá nhân Nông dân (Farmer Details)
// ------------------------------------------------------------
Table farmer_profiles {
  id UUID [pk]
  user_id UUID [unique, not null, ref: - users.id, note: 'Quan hệ 1-1 Nông dân']
  first_name VARCHAR
  last_name VARCHAR
  phone VARCHAR
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
}

// ------------------------------------------------------------
// 2b. Bảng hồ sơ cá nhân Quản trị viên (Admin Details)
// ------------------------------------------------------------
Table admin_profiles {
  id UUID [pk]
  user_id UUID [unique, not null, ref: - users.id, note: 'Quan hệ 1-1 Admin']
  first_name VARCHAR
  last_name VARCHAR
  phone VARCHAR
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
}

// ------------------------------------------------------------
// 3. Bảng tài khoản xã hội (Social Logins)
// ------------------------------------------------------------
Table user_social_accounts {
  id UUID [pk]
  user_id UUID [not null, ref: > users.id, note: 'Quan hệ 1-N']
  provider VARCHAR [not null]
  provider_user_id VARCHAR [unique, not null]
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
  
  Indexes {
    user_id
    provider
    provider_user_id
    (user_id, provider) [unique]
  }
}

// ------------------------------------------------------------
// 4. Bảng bệnh lúa (Master Data)
// ------------------------------------------------------------
Table diseases {
  id UUID [pk]
  name NVARCHAR(100) [unique, not null]
  scientific_name VARCHAR(150) [unique]
  ai_class_name VARCHAR(50) [unique, not null, note: 'Mapping code from YOLO model']
  signs TEXT [note: 'Dấu hiệu bệnh']
  status enum('visible', 'hidden') [not null, default: 'visible']
  severity VARCHAR(50) [default: 'medium']
  treatment TEXT
  image_url VARCHAR(512)
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
}

// ------------------------------------------------------------
// 5. Bảng tri thức dinh dưỡng (Vector Database)
// ------------------------------------------------------------
Table nutritions {
  id UUID [pk]
  content TEXT [not null]
  source NVARCHAR(100)
  embedding "VECTOR(3072)" [note: 'Vector ngữ nghĩa (pgvector)']
  chunk_metadata JSONB [note: 'Thông tin bổ sung, hỗ trợ GIN Index']
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
  
  Note: 'Kho tri thức phục vụ tìm kiếm ngữ nghĩa (RAG)'
}

// ------------------------------------------------------------
// 6. Bảng lượt chẩn đoán (Transactions)
// ------------------------------------------------------------
Table diagnoses {
  id UUID [pk]
  user_id UUID [not null, ref: > users.id]
  original_image_url VARCHAR(512) [not null]
  result_image_url VARCHAR(512)
  gps_lat DECIMAL(10,8) [note: 'Tọa độ gọi API thời tiết']
  gps_lng DECIMAL(11,8)
  province TEXT [note: 'Tỉnh/thành phố']
  weather_data JSONB [note: 'Dữ liệu thời tiết từ API']
  env_description TEXT [note: 'Mô tả bối cảnh môi trường / thời tiết']
  field_description TEXT [note: 'Mô tả tình trạng thực địa / triệu chứng chi tiết']
  field_params JSONB [note: 'Thông số thực địa (nước, tăng trưởng, mật độ, ...)']
  field_id UUID [ref: > user_fields.id, note: 'Liên kết tới vị trí ruộng']
  model_version_id UUID [not null, ref: > ai_models.id]
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
  
  Indexes {
    user_id
    model_version_id
  }
}

// ------------------------------------------------------------
// 7. Bảng kết quả chẩn đoán (1-N)
// ------------------------------------------------------------
Table diagnosis_results {
  id UUID [pk]
  diagnosis_id UUID [not null, ref: > diagnoses.id]
  disease_id UUID [not null, ref: > diseases.id]
  confidence DECIMAL(5,2) [note: 'Độ tin cậy 0-100.00%']
  mask_polygon JSONB [note: 'Tọa độ polygon dạng JSONB']
  color VARCHAR(20) [note: 'Màu sắc bounding box/mask']
  advisory JSONB [note: 'Thông tin khuyến nghị/cách xử lý']
  affected_area_ratio DECIMAL(5,4) [note: 'Tỷ lệ diện tích bị nhiễm bệnh (0-1.0000)']
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
  
  Indexes {
    diagnosis_id
    disease_id
  }
}

// ------------------------------------------------------------
// 8. Bảng phản hồi (Feedbacks)
// ------------------------------------------------------------
Table feedbacks {
  id UUID [pk]
  diagnosis_id UUID [not null, ref: > diagnoses.id]
  user_id UUID [not null, ref: > users.id]
  user_message TEXT [note: 'Lời nhắn nông dân']
  status enum('pending', 'accepted', 'rejected') [not null, default: 'pending']
  admin_id UUID [ref: > users.id, note: 'Admin xử lý (nullable)']
  admin_response TEXT [note: 'Lời nhắn admin gửi lại']
  processed_at TIMESTAMP
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
  
  Indexes {
    diagnosis_id
    user_id
    status
  }
}

// ------------------------------------------------------------
// 9. Bảng trung gian: Bệnh thực tế từ phản hồi (Junction)
// ------------------------------------------------------------
Table feedback_actual_diseases {
  feedback_id UUID [not null, ref: > feedbacks.id]
  disease_id UUID [not null, ref: > diseases.id]
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
  
  Indexes {
    (feedback_id, disease_id) [pk]
  }
  
  Note: 'Bảng trung gian lưu vết bệnh thực tế do nông dân báo cáo'
}

// ------------------------------------------------------------
// 10. Bảng mô hình AI (MLOps Tracking)
// ------------------------------------------------------------
Table ai_models {
  id UUID [pk]
  version_name NVARCHAR(50) [not null]
  file_path VARCHAR(512) [not null]
  release_notes TEXT
  is_active BOOLEAN [not null, default: false]
  uploaded_by UUID [not null, ref: > users.id]
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP
}

// ------------------------------------------------------------
// 11. Bảng quản lý vị trí ruộng đất (User Fields)
// ------------------------------------------------------------
Table user_fields {
  id UUID [pk]
  user_id UUID [not null, ref: > users.id, note: 'Quan hệ 1-N']
  field_name VARCHAR(100) [not null]
  address VARCHAR(255)
  gps_lat DECIMAL(10,8) [not null]
  gps_lng DECIMAL(11,8) [not null]
  is_default BOOLEAN [not null, default: false]
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP

  Indexes {
    user_id
    is_default
  }
}

// ------------------------------------------------------------
// 12. Bảng cấu hình hệ thống (System Configurations)
// ------------------------------------------------------------
Table system_configs {
  id UUID [pk]
  key VARCHAR(100) [unique, not null]
  value TEXT [not null]
  description TEXT
  is_active BOOLEAN [not null, default: true]
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP

  Indexes {
    key
  }
}

// ------------------------------------------------------------
// 13. Phân hệ Diễn đàn (Farmer Forum)
// ------------------------------------------------------------
Table posts {
  id UUID [pk]
  author_id UUID [not null, ref: > users.id]
  content TEXT [not null]
  images JSONB [note: 'Mảng danh sách link ảnh CDN, mặc định []']
  tags JSONB [note: 'Mảng danh sách thẻ tag, mặc định []']
  upvotes INTEGER [not null, default: 0]
  downvotes INTEGER [not null, default: 0]
  comment_count INTEGER [not null, default: 0]
  score INTEGER [not null, default: 0, note: 'Điểm số Hot: upvotes + (comment_count * 2)']
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP

  Indexes {
    author_id
    score
  }
}

Table comments {
  id UUID [pk]
  post_id UUID [not null, ref: > posts.id, note: 'ON DELETE CASCADE']
  author_id UUID [not null, ref: > users.id]
  parent_id UUID [ref: > comments.id, note: 'ON DELETE CASCADE']
  content TEXT [not null]
  upvotes INTEGER [not null, default: 0]
  downvotes INTEGER [not null, default: 0]
  created_at TIMESTAMP [default: `now()`]
  updated_at TIMESTAMP

  Indexes {
    post_id
    parent_id
  }
}

Table post_votes {
  id UUID [pk]
  post_id UUID [not null, ref: > posts.id, note: 'ON DELETE CASCADE']
  user_id UUID [not null, ref: > users.id]
  type VARCHAR(10) [not null, note: 'up | down']

  Indexes {
    (post_id, user_id) [unique]
  }
}

Table comment_votes {
  id UUID [pk]
  comment_id UUID [not null, ref: > comments.id, note: 'ON DELETE CASCADE']
  user_id UUID [not null, ref: > users.id]
  type VARCHAR(10) [not null, note: 'up | down']

  Indexes {
    (comment_id, user_id) [unique]
  }
}
